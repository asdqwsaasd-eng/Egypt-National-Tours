# ────────────────────────────────────────────────────────
# Egypt National Tours — Environment Variables
# ────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to version control.
# ────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/egypt_national_tours?schema=public"

# ── Authentication ────────────────────────────────────
# Secret key for session signing (generate a strong random string)
AUTH_SECRET="CHANGE_ME_generate_a_strong_random_secret"

# ── Email ─────────────────────────────────────────────
# Email service provider (e.g., resend, sendgrid, smtp)
EMAIL_PROVIDER="resend"
EMAIL_PROVIDER_API_KEY=""
# Default notification recipient
EMAIL_NOTIFICATION_RECIPIENT="egypt_nationaltours@yahoo.com"

# ── Storage ───────────────────────────────────────────
# Storage provider (e.g., local, s3, r2, supabase)
STORAGE_PROVIDER="local"
STORAGE_BUCKET=""
STORAGE_REGION=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_ENDPOINT=""

# ── Site ──────────────────────────────────────────────
# Public-facing site URL (used for SEO, canonical URLs, OG tags)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── WhatsApp ──────────────────────────────────────────
# WhatsApp number for customer contact (without + prefix)
NEXT_PUBLIC_WHATSAPP_NUMBER="201063314240"
